---
title: Birdhouse | A UI for your AI agents
layout: layout.vto
download_link: https://github.com/birdhouse-labs/birdhouse
metas:
  site: Birdhouse Labs
  title: Birdhouse | A UI for your AI agents
  description: A UI for your AI agents. Agents communicate, collaborate, and are organized as a tree.
  keywords: [AI agents, multi-agent systems, agent orchestration, AI development, collaborative AI, AI coding, agentic development, AI team collaboration]
  author: Birdhouse Labs
  robots: index, follow
  lang: en
  icon: /assets/favicon.ico
  image: /assets/og-image.png
  twitter: "@BirdhouseLabsAI"
---

<!-- NAVBAR -->
<header
  id="nav"
  data-scrolling="false"
  class="fixed top-0 left-0 right-0 z-50 px-6 h-14 flex items-center justify-between bg-white/80 backdrop-blur-sm border-b border-transparent data-[scrolling=true]:border-[#E8E6E1] transition-colors duration-200"
>
  <div class="flex items-center gap-2">
    <img class="h-6" src="assets/logo.png" alt="Birdhouse" />
  </div>
  <a
    href="{{ download_link }}"
    class="inline-flex items-center gap-2 px-4 py-1.5 rounded-lg bg-[#7C3AED] text-white text-sm font-medium hover:bg-[#6D28D9] transition-colors"
  >
    <i data-lucide="github" class="w-4 h-4"></i>
    View on GitHub
  </a>
</header>

<!-- HERO -->
<main class="pt-14">
  <section class="bg-white px-6 pt-24 pb-20 flex flex-col items-center text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F4F0FF] text-[#7C3AED] text-xs font-medium mb-8 border border-[#DDD6FE]">
      <span class="w-1.5 h-1.5 rounded-full bg-[#7C3AED] inline-block"></span>
      Open source
    </div>

    <h1 class="text-balance text-5xl md:text-6xl font-bold text-[#1A1917] leading-tight max-w-3xl mb-6">
      A UI for your<br class="hidden md:block" />
      <span class="text-[#7C3AED]">AI agents</span>
    </h1>

    <p class="text-pretty text-lg text-[#6B7280] max-w-xl mb-10 leading-relaxed">
      Birdhouse gives your agents a place to communicate and collaborate,
      organized as a navigable tree. Built for agentic software development.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3 mb-16">
      <a
        href="{{ download_link }}"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[#7C3AED] text-white font-medium hover:bg-[#6D28D9] transition-colors"
      >
        <i data-lucide="github" class="w-4 h-4"></i>
        View on GitHub
      </a>
      <a
        href="#updates"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-[#E8E6E1] text-[#1A1917] font-medium hover:bg-[#F4F3F1] transition-colors"
      >
        Stay updated
      </a>
    </div>

    <!-- Metrics -->
    <div
      id="hero-metrics"
      class="flex items-center gap-12 md:gap-20 mb-16"
      role="status"
      aria-live="polite"
    >
      <div class="flex flex-col items-center gap-1">
        <span id="metric-agents" class="text-3xl md:text-4xl font-bold text-[#1A1917] tabular-nums">—</span>
        <span class="text-xs text-[#9CA3AF] uppercase tracking-widest">Agents Created</span>
      </div>
      <div class="w-px h-10 bg-[#E8E6E1]"></div>
      <div class="flex flex-col items-center gap-1">
        <span id="metric-tokens" class="text-3xl md:text-4xl font-bold text-[#1A1917] tabular-nums">—</span>
        <span class="text-xs text-[#9CA3AF] uppercase tracking-widest">Tokens Processed</span>
      </div>
    </div>

    <!-- Screenshot -->
    <div class="w-full max-w-5xl rounded-xl border border-[#E8E6E1] shadow-xl overflow-hidden">
      <div class="h-8 bg-[#F4F3F1] border-b border-[#E8E6E1] flex items-center px-4 gap-2">
        <span class="w-3 h-3 rounded-full bg-[#E8E6E1]"></span>
        <span class="w-3 h-3 rounded-full bg-[#E8E6E1]"></span>
        <span class="w-3 h-3 rounded-full bg-[#E8E6E1]"></span>
      </div>
      <img
        src="/assets/hero-screenshot.png"
        alt="A screenshot of Birdhouse"
        class="w-full"
      />
    </div>
  </section>

  <!-- MAILING LIST -->
  <section
    id="updates"
    class="bg-[#F4F3F1] px-6 py-24 flex flex-col items-center text-center"
  >
    <h2 class="text-balance text-3xl md:text-4xl font-bold text-[#1A1917] mb-3">
      Stay in the loop
    </h2>
    <p class="text-[#6B7280] mb-10 max-w-sm">
      Sign up for Birdhouse news and updates.
    </p>

    <div class="w-full max-w-sm bg-white rounded-xl border border-[#E8E6E1] shadow-sm p-6">
      <form class="flex flex-col gap-3" id="waitlist-form">
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          class="w-full px-4 py-2.5 rounded-lg border border-[#E8E6E1] text-[#1A1917] text-sm placeholder:text-[#9CA3AF] outline-none focus:ring-2 focus:ring-[#7C3AED] focus:ring-offset-2 transition"
          required
        />
        <button
          type="submit"
          class="w-full px-4 py-2.5 rounded-lg bg-[#7C3AED] text-white text-sm font-medium hover:bg-[#6D28D9] transition-colors"
        >
          Sign up
        </button>
      </form>
      <p class="mt-4 text-xs text-[#9CA3AF]">
        Questions? <a href="mailto:hello@birdhouselabs.ai" class="text-[#7C3AED] hover:underline">hello@birdhouselabs.ai</a>
      </p>
    </div>
  </section>
</main>

<!-- FOOTER -->
<footer class="bg-white border-t border-[#E8E6E1] px-6 py-8 flex items-center justify-between">
  <p class="text-sm text-[#9CA3AF]">
    Built by the <i class="inline" data-lucide="bird" style="width:14px;height:14px;vertical-align:middle"></i> at Birdhouse Labs
  </p>
  <a href="{{ download_link }}" class="text-sm text-[#9CA3AF] hover:text-[#7C3AED] transition-colors">GitHub</a>
</footer>
