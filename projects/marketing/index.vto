---
title: Birdhouse — OpenCode UI for agent teams
layout: layout.vto
download_link: https://github.com/birdhouse-labs/birdhouse
metas:
  site: Birdhouse
  title: Birdhouse — OpenCode UI for agent teams
  description: An open source UI for OpenCode built around agent teams. Organize subagents in a tree, open them as browser tabs, and let them communicate.
  keywords: [AI agents, multi-agent systems, agent orchestration, OpenCode, subagents, agentic development, AI coding]
  author: Cody Rayment
  robots: index, follow
  lang: en
  icon: /assets/favicon.svg
  image: /assets/og-image.png
  twitter: "@BirdhouseLabsAI"
---

<!-- NAVBAR -->
<header
  id="nav"
  data-scrolling="false"
  class="fixed top-0 left-0 right-0 z-50 px-6 h-14 flex items-center justify-between bg-white/80 backdrop-blur-sm border-b border-transparent data-[scrolling=true]:border-[#E8E6E1] transition-colors duration-200"
>
  <a href="/" class="flex items-center gap-2 no-underline">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 18v4" fill="none" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="m17 18 1.956-11.468" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="m3 8 7.82-5.615a2 2 0 0 1 2.36 0L21 8" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4 18h16" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M7 18 5.044 6.532" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="12" cy="10" r="2" stroke="#7C3AED" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="font-semibold text-base tracking-tight text-[#1A1917]">birdhouse</span>
  </a>
  <a
    href="{{ download_link }}"
    class="inline-flex items-center gap-2 px-4 py-1.5 rounded-lg bg-[#7C3AED] text-white text-sm font-medium hover:bg-[#6D28D9] transition-colors"
  >
    <i data-lucide="github" class="w-4 h-4"></i>
    View on GitHub
  </a>
</header>

<!-- HERO -->
<main class="pt-14">
  <section class="bg-white px-6 pt-24 pb-20 flex flex-col items-center text-center">
    <h1 class="text-balance text-5xl md:text-6xl font-bold text-[#1A1917] leading-tight max-w-3xl mb-4">
      A UI for your <span class="text-[#7C3AED]">AI agents</span>.
    </h1>

    <p class="text-pretty text-xl text-[#1A1917] max-w-xl mb-4 leading-relaxed font-medium">
      An open source UI for <a href="https://opencode.ai" class="text-[#7C3AED] hover:underline">OpenCode</a>, built around agent teams.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3 mb-16">
      <a
        href="{{ download_link }}"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-[#7C3AED] text-white font-medium hover:bg-[#6D28D9] transition-colors"
      >
        <i data-lucide="github" class="w-4 h-4"></i>
        View on GitHub
      </a>
      <a
        href="#updates"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-[#E8E6E1] text-[#1A1917] font-medium hover:bg-[#F4F3F1] transition-colors"
      >
        Stay updated
      </a>
    </div>

    <!-- Metrics -->
    <div
      id="hero-metrics"
      class="flex items-center gap-12 md:gap-20 mb-16"
      role="status"
      aria-live="polite"
    >
      <div class="flex flex-col items-center gap-1">
        <span id="metric-agents" class="text-3xl md:text-4xl font-bold text-[#1A1917] tabular-nums">—</span>
        <span class="text-xs text-[#9CA3AF] uppercase tracking-widest">Agents Created</span>
      </div>
      <div class="w-px h-10 bg-[#E8E6E1]"></div>
      <div class="flex flex-col items-center gap-1">
        <span id="metric-tokens" class="text-3xl md:text-4xl font-bold text-[#1A1917] tabular-nums">—</span>
        <span class="text-xs text-[#9CA3AF] uppercase tracking-widest">Tokens Processed</span>
      </div>
    </div>

    <!-- Screenshot -->
    <div class="w-full max-w-5xl rounded-xl border border-[#E8E6E1] shadow-xl overflow-hidden">
      <img
        src="/assets/hero-screenshot.png"
        alt="A screenshot of Birdhouse"
        class="w-full"
      />
    </div>
  </section>

  <!-- MAILING LIST -->
  <section
    id="updates"
    class="relative bg-[#F4F3F1] px-6 py-24 flex flex-col items-center text-center overflow-hidden"
  >
    <img
      src="/assets/flock.png"
      alt=""
      aria-hidden="true"
      class="absolute -bottom-6 right-0 w-72 md:w-96 opacity-60 pointer-events-none select-none"
      style="filter: sepia(1) saturate(2) hue-rotate(220deg) brightness(0.75)"
    />
    <h2 class="text-balance text-3xl md:text-4xl font-bold text-[#1A1917] mb-3">
      Stay in the loop
    </h2>
    <p class="text-[#6B7280] mb-10 max-w-sm">
      Sign up for Birdhouse news and updates.
    </p>

    <div class="w-full max-w-sm bg-white rounded-xl border border-[#E8E6E1] shadow-sm p-6">
      <form class="flex flex-col gap-3" id="waitlist-form">
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          class="w-full px-4 py-2.5 rounded-lg border border-[#E8E6E1] text-[#1A1917] text-sm placeholder:text-[#9CA3AF] outline-none focus:ring-2 focus:ring-[#7C3AED] focus:ring-offset-2 transition"
          required
        />
        <button
          type="submit"
          class="w-full px-4 py-2.5 rounded-lg bg-[#7C3AED] text-white text-sm font-medium hover:bg-[#6D28D9] transition-colors"
        >
          Sign up
        </button>
      </form>
      <p class="mt-4 text-xs text-[#9CA3AF]">
        Questions? <a href="mailto:hello@birdhouselabs.ai" class="text-[#7C3AED] hover:underline">hello@birdhouselabs.ai</a>
      </p>
    </div>
  </section>
</main>

<!-- FOOTER -->
<footer class="bg-white border-t border-[#E8E6E1] px-6 py-8 flex items-center justify-between">
  <p class="text-sm text-[#9CA3AF]">
    Built by <a href="https://github.com/crayment" class="text-[#9CA3AF] hover:text-[#7C3AED] transition-colors">Cody Rayment</a>
  </p>
  <a href="{{ download_link }}" class="text-sm text-[#9CA3AF] hover:text-[#7C3AED] transition-colors">GitHub</a>
</footer>
