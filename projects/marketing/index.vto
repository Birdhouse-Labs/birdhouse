---

<!-- NAVBAR -->
<div
  id="nav"
  data-scrolling="false"
  class="px-4 py-2 navbar justify-between fixed group data-[scrolling=true]:bg-base-100 bg-transparent top-0 z-50"
>
  <div>
    <img class="w-[200px]" src="assets/logo.png" alt="Birdhouse Labs" />
  </div>

  <div class="flex-none">
    <a href="{{ download_link }}" target="_blank" class="btn btn-primary btn-sm md:btn-md">
      View on GitHub
    </a>
  </div>
</div>

<!-- HERO SECTION -->
<div
  class="hero bg-base-100 md:min-h-screen pt-24 md:pt-42 pb-16 bg-cover bg-[url(/assets/hero-overlay-3t.webp)] bg-contain"
>
  <div
    class="hero-content flex-col items-center justify-center px-4 w-full max-w-7xl text-center"
  >
    <div class="text-left text-center flex flex-col items-center">
      <div class="h-1 w-12 bg-primary mb-4"></div>
      <p
        class="py-6 text-4xl md:text-5xl text-center text-base-content/90 leading-tight max-w-3xl lg:mx-auto mb-4 md:mb-6"
      >
        A UI for your AI agents.<br />
        Communicate. Collaborate.<br class="hidden md:block" />
        Organized as a tree.
      </p>
      <div class="flex justify-center mb-4 md:mb-6">
        <a
          href="{{ download_link }}"
          target="_blank"
          class="btn btn-primary btn-lg gap-2 px-8"
        >
          <i data-lucide="github"></i>
          View on GitHub
        </a>
      </div>
    </div>

    <div
      id="hero-metrics"
      class="flex flex-row items-center justify-center gap-8 md:gap-16 mt-8"
      role="status"
      aria-live="polite"
    >
      <div class="flex flex-col items-center">
        <span id="metric-agents" class="text-3xl md:text-5xl font-bold text-primary tabular-nums">—</span>
        <span class="text-sm md:text-base text-base-content/60 mt-1 tracking-wide uppercase">Agents Created</span>
      </div>
      <div class="w-px h-12 bg-base-content/20"></div>
      <div class="flex flex-col items-center">
        <span id="metric-tokens" class="text-3xl md:text-5xl font-bold text-primary tabular-nums">—</span>
        <span class="text-sm md:text-base text-base-content/60 mt-1 tracking-wide uppercase">Tokens Processed</span>
      </div>
    </div>

    <div
      class="md:mockup-window border border-[#2a2622] mt-8 lg:w-2/3 bg-[#2a2622]"
    >
      <div
        id="hero-app-placeholder"
        class="border-t border-[#2a2622]"
      >
        <img
          src="/assets/hero-screenshot.png"
          alt="A screenshot of Birdhouse"
        />
      </div>
    </div>
  </div>
</div>

<!-- MAILING LIST SECTION -->
<div
  id="waitlist"
  class="hero min-h-screen bg-base-200/40 glass"
>
  <div class="hero-content text-center text-primary flex-col px-4">
    <div class="max-w-2xl">
      <h2 class="text-6xl md:text-7xl mb-6 leading-tight">
        Stay in the loop
      </h2>

      <p class="text-xl text-base-content/70 mb-12">
        Sign up for Birdhouse news and updates.
      </p>

      <!-- WAITLIST FORM -->
      <div class="card bg-base-100 shadow-2xl max-w-md w-full mx-auto">
        <div class="card-body gap-6">
          <h3 class="card-title text-2xl text-base-content">
            Get Updates
          </h3>

          <form class="space-y-4" id="waitlist-form">
            <input
              type="email"
              name="email"
              placeholder="your@email.com"
              class="input input-bordered w-full text-base-content"
              required
            />

            <button
              type="submit"
              class="btn btn-primary btn-lg w-full gap-2"
            >
              Sign up
            </button>
          </form>
        </div>
      </div>

      <p class="mt-8 text-center text-base-content/70">
        Questions? Reach out to the team <a
          href="mailto:hello@birdhouselabs.ai"
          class="link link-primary font-bold"
        >here</a>.
      </p>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer class="footer bg-base-100 text-base-content p-10">
  <div>
    <p class="text-sm text-base-content/60 mt-2">
      Built by the <i class="inline" data-lucide="bird"></i> at Birdhouse Labs
    </p>
  </div>
</footer>
